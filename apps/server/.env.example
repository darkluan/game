# ---- Server ----
# Port the HTTP + WebSocket server listens on.
PORT=2567
# development | production
NODE_ENV=development

# ---- Auth ----
# Signs guest tokens. Required in production, at least 32 characters.
# Generate with: openssl rand -hex 32
TOKEN_SECRET=
# OAuth client ID (type "Web application") from Google Cloud Console. Empty turns Google sign-in off.
GOOGLE_CLIENT_ID=

# ---- Database ----
# PostgreSQL connection URL. Empty: players and history are kept in memory only (lost on restart),
# and ranked matchmaking is switched off in production.
DATABASE_URL=

# ---- CORS ----
# Web origins allowed to call this server, comma-separated, no trailing slash.
# Production: required, an empty list denies every browser. Development: empty allows any origin.
CORS_ALLOWED_ORIGINS=

# ---- Matchmaking (all optional; defaults shown) ----
# How often the queue is scanned, in milliseconds.
MATCH_SCAN_MS=1000
# MMR range a player starts with, and how much it grows every MATCH_RANGE_STEP_SECONDS of waiting.
MATCH_RANGE_START=100
MATCH_RANGE_STEP=50
MATCH_RANGE_STEP_SECONDS=10
# Seconds of waiting after which empty seats are filled with bots.
MATCH_BOT_FILL_SECONDS=75
# Seconds to accept a found match, and to pick a hero.
MATCH_ACCEPT_SECONDS=10
MATCH_DRAFT_SECONDS=30
