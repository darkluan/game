# ---- Server ----
# Port the HTTP + WebSocket server listens on.
PORT=2567
# development | production
NODE_ENV=development

# ---- Auth ----
# Signs guest tokens. Required in production, at least 32 characters.
# Generate with: openssl rand -hex 32
TOKEN_SECRET=

# ---- CORS ----
# Web origins allowed to call this server, comma-separated, no trailing slash.
# Production: required, an empty list denies every browser. Development: empty allows any origin.
CORS_ALLOWED_ORIGINS=
